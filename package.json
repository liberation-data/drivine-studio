{
  "name": "drivine-studio",
  "productName": "Drivine Studio",
  "version": "0.1.0",
  "main": "main.cjs",
  "private": true,
  "description": "Browse a Drivine model, load it, and see the graph. Reads and never writes.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --port 5187",
    "build": "next build && mkdir -p .next/standalone/.next/static && cp -R .next/static/. .next/standalone/.next/static/ && (test ! -d public || cp -R public/. .next/standalone/public/)",
    "start": "PORT=${PORT:-5187} node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "electron": "npm run build && electron .",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:watch": "concurrently \"npm run dev\" \"ELECTRON_DEV=1 ELECTRON_DEVTOOLS=1 electron .\"",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:mac:dmg": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --dir",
    "package:win:installer": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux --dir",
    "package:linux:appimage": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --mac --win --linux",
    "test": "vitest run --exclude '**/*.db.test.ts' --exclude '**/node_modules/**'",
    "test:db": "vitest run db.test"
  },
  "dependencies": {
    "@liberation-data/desk": "^0.35.2",
    "@liberation-data/drivine": "^3.2.0",
    "cytoscape": "^3.30.0",
    "neo4j-driver": "^5.28.3",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "testcontainers": "^11.14.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "org.drivine.studio",
    "productName": "Drivine Studio",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "files": [
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "main.cjs",
      "server-start.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
